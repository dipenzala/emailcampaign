{
  "name": "emailcampaign",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,worker -c cyan,magenta \"next dev -p 3000\" \"tsx watch workers/sender.worker.ts\"",
    "build": "prisma generate && prisma db push --skip-generate --accept-data-loss && next build",
    "start": "concurrently -n next,worker -c cyan,magenta \"next start -p 3000\" \"tsx workers/sender.worker.ts\"",
    "worker": "tsx workers/sender.worker.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "echo skipping-postinstall",
    "db:reset-users": "node scripts/pre-migrate.js && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.28.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.1",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "^2.13.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "nanoid": "^5.0.9",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15"
  }
}